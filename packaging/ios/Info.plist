<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Squallar</string>
    <key>CFBundleDisplayName</key>
    <string>Squallar</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <!-- Device and simulator bundles differ here, so these three expand
         per-target (ios/Makefile). `simctl install` rejects a bundle whose
         CFBundleSupportedPlatforms does not name iPhoneSimulator. -->
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>$(SUPPORTED_PLATFORM)</string>
    </array>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
            </array>
        </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
                <string>AppIcon76x76</string>
            </array>
        </dict>
    </dict>
    <key>DTPlatformName</key>
    <string>$(PLATFORM_NAME)</string>
    <key>DTSDKName</key>
    <string>$(SDK_NAME)</string>
    <!-- The rest of the DT family. Absent, App Store Connect concludes the app
         was built with a beta toolchain and refuses the upload with error
         90534, "Unsupported SDK or Xcode version" — which is what happened to
         every iOS build before these keys existed, while the Mach-O itself
         carried a perfectly current sdk 26.4. The bundle, not the binary, is
         what that check reads.

         DTSDKBuild, DTPlatformBuild and DTPlatformVersion are filled from the
         SDK the link actually used, so they cannot drift from the image.
         DTXcode and DTXcodeBuild cannot be: an SDK does not record which Xcode
         shipped it. The Makefile keeps a table keyed on the SDK build and
         refuses to build against an SDK it has no row for, rather than
         inventing an Xcode that never shipped it. -->
    <key>DTSDKBuild</key>
    <string>$(SDK_BUILD)</string>
    <key>DTPlatformBuild</key>
    <string>$(SDK_BUILD)</string>
    <key>DTPlatformVersion</key>
    <string>$(SDK_PRODUCT_VERSION)</string>
    <key>DTXcode</key>
    <string>$(DTXCODE)</string>
    <key>DTXcodeBuild</key>
    <string>$(XCODE_BUILD)</string>
    <key>BuildMachineOSBuild</key>
    <string>$(MACHINE_OS_BUILD)</string>
    <key>DTCompiler</key>
    <string>com.apple.compilers.llvm.clang.1_0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- iPhone presentation clamps to 60 Hz on ProMotion panels without this
         key; iPads are exempt. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <!-- Must match IOS_MIN in packaging/ios/Makefile, which the build asserts
         against the Mach-O's own LC_BUILD_VERSION minos rather than trusting
         both to say the same thing.

         15.0 because App Store Connect warns on anything lower (90068) and
         makes it a hard refusal in Spring 2027. Raised ahead of the deadline
         rather than on it: the warning arrives on every upload, and a floor
         that becomes an error is a worse thing to discover during a release. -->
    <key>MinimumOSVersion</key>
    <string>15.0</string>
    <!-- 1 = iPhone/iPod, 2 = iPad. Absent, this defaults to iPhone-only, which
         is what left `UISupportedInterfaceOrientations~ipad` below inert. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <!-- Empty launch screen (iOS 13+); winit owns the window, so no storyboard. -->
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>metal</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- Deliberately no UIStatusBarHidden: the status bar and the notch are what
         put a non-zero top value in `RawInput::safe_area_insets`, which is the
         inset path this build exists to exercise. -->
    <!-- Read by iOS the moment `os_location/apple.rs` calls
         `requestWhenInUseAuthorization`, which it does when the user turns
         Location on. iOS kills the app on that call if this key is missing.
         The macOS bundle needs `NSLocationUsageDescription` as well — that key
         is the macOS spelling and this one does not exist there; see
         macos/Info.plist.

         No `UIBackgroundModes: location` here, deliberately. Without it the OS
         stops delivering while the app is backgrounded and the map keeps its
         last dot until the app returns; with it, the app would be asking for a
         capability it has no use for and would have to justify. See the module
         note in squallar-location/src/os_location/apple.rs. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Squallar marks where you are and which way you are moving on the weather radar map, and opens the nearest radar site instead of asking you to pick one. Location is read only while the app is open, and every part of the map works without it.</string>
    <!-- Export compliance, and `false` here is a checked claim rather than an
         assumed one.

         Everything this app sends leaves over HTTPS or WSS. The transport is
         `rustls` speaking published TLS 1.2/1.3, and the trust decision — the
         part that would otherwise be cryptography of our own — is handed to
         Apple's Security.framework through `rustls-platform-verifier`; see
         `squallar-source/src/tls.rs`, which installs the provider once and
         sets `https_only(true)`. The only other algorithms in the Apple
         dependency graph are the RFC 6455 `Sec-WebSocket-Accept` SHA-1
         handshake digest and non-cryptographic hashes (crc32, adler, xxh3,
         ahash) used for checksums and hash maps. This app implements no
         cryptography of its own, signs no requests — the NEXRAD S3 buckets are
         read anonymously, with no SigV4 and no credential chain — stores
         nothing encrypted, and offers the user no encryption feature.

         Declaring the key at all is what stops App Store Connect asking the
         export question on every upload.

         **What would re-open this:** shipping a cipher for anything but TLS;
         adding an encryption feature a user can point at (encrypted archives,
         an account with client-side key material, end-to-end sharing); or
         moving the App Store Connect ES256 token signer into the app, which is
         CI Python (`.github/scripts/appstore-upload.py`) today and never
         enters the bundle. Adding SigV4 to the S3 reads would stay exempt, but
         it changes the reasoning above from "nothing beyond TLS" to "TLS plus
         standard authentication", so it should be rewritten, not left.

         This is the self-classification only. The separate French declaration
         App Store Connect asks about is a human's call, not this file's. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
