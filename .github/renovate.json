{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>USA-RedDragon/renovate-configs"
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com",
    "323064949+squallar-autocommit[bot]@users.noreply.github.com",
    "234130638+github-actions[bot]@users.noreply.github.com"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "vendor/**"
  ],
  "packageRules": [
    {
      "groupName": "egui",
      "matchDatasources": [
        "crate"
      ],
      "matchPackageNames": [
        "egui",
        "egui-winit",
        "egui-wgpu",
        "naga",
        "walkers",
        "wgpu"
      ]
    }
  ]
}
